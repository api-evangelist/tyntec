          "id": "8992bde1-3f35-4eea-9e6c-81aee670f6b8",
          "name": "Verify a phone number",
          "request": {
            "name": "Verify a phone number",
            "description": {
              "content": "Validates the given phone number (E.164, without a leading +) against a named criteria template. Returns whether the number passes, plus the underlying number intelligence used to decide - validity, reachability (active subscriber), line type, operator, country, MCC/MNC, and disposable-number flags.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "verify",
                "v1",
                "phone",
                ":number"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "criteria",
                  "value": "<string>",
                  "description": "Name of a previously created criteria template to evaluate the number against."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "number",
                  "description": "(Required) The phone number to verify, in international E.164 format without the leading plus."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
